<?xml version="1.0" encoding="UTF-8"?>
<layout isUseWallpaper="false" skinFrameVerCode="9">
    <group background="launcher/main_bg.png" h="-1" id="launcher" w="-1" x="0" y="0">
        <linear w="106" h="-1" y="50" orientation="vertical" background="#0C1519">
            <image h="178" w="-1" y="8" src="#n:launcher/setting_n.png;#p:launcher/setting_p.png" scaleType="fitXY" >
                <trigger>
                    <action name="cn.yunovo.car.settings/cn.yunovo.car.settings.SettingsListActivity" type="activity" />
                </trigger>
            </image>
            <image h="178" w="-1"  src="#n:launcher/application_n.png;#p:launcher/application_p.png" scaleType="fitXY">
                <trigger>
                    <action name="com.car.launcher.allapps" type="activity" />
                </trigger>
            </image>
            <navModule h="178" w="-1"  background="#n:launcher/nav_n.png;#p:launcher/nav_p.png"  scaleType="fitXY">
                <trigger>
                    <action name="com.google.android.apps.maps/com.google.android.maps.MapsActivity" type="activity" />
                    <action name="android.intent.action.MAIN" type="action" />
                </trigger>
            </navModule>
        </linear>
        <slide card_h="405" card_w="272" col="3" h="405" indicator="indicator" row="1" supportDrag="true" type="page" w="-1" x="106" y="120">
            <navModule background="launcher/map_card.png">
                <text color="#FFFFFF" h="-2" id="nav_speed" layout_gravity="center_horizontal" size="48" text="0" w="-2" y="33" />
                <text color="#FFFFFF" h="-2" id="nav_speed_unit"  size="24" text="km/h" w="-2"  y="98" layout_gravity="center_horizontal" />
                <trigger>
                    <action name="com.google.android.apps.maps/com.google.android.maps.MapsActivity" type="activity" />
                    <action name="android.intent.action.MAIN" type="action" />
                </trigger>
            </navModule>
            <musicModule background="launcher/music_card.png" supportFm="true">
                <linear h="67" layout_gravity="center_horizontal" orientation="vertical" w="240" y="270">
                    <image weight="1" />
                    <!-- 歌曲名字 -->
                    <text color="#000000" ellipsize="marquee" id="title"
                        layout_gravity="center_horizontal" singleLine="true" size="28"
                        text="@string:song_name" />
                    <!-- 歌手名字 -->
                    <text color="#b3000000" ellipsize="end" id="author"
                        layout_gravity="center_horizontal" singleLine="true" size="16"
                        text="@string:singer"/>
                    <image weight="1" />
                </linear>

                <!-- 开始暂停按钮 -->
                <image h="56" id="play" padding="10,10,10,10" scaleType="fitXY" src="launcher/btn_play.png" visibility="gone" w="56"  y="340" layout_gravity="center_horizontal" />
                <!-- 开始暂停按钮 -->
                <image h="56" id="pause" padding="10,10,10,10" scaleType="fitXY" src="launcher/btn_pause.png" visibility="gone" w="56"  y="340" layout_gravity="center_horizontal" />
                <!-- 上一曲按钮 -->
                <image h="45" id="prev" padding="10,10,10,10" scaleType="fitXY" src="#n:launcher/btn_pre_n.png;#p:launcher/btn_pre_p.png" w="45" x="37" y="345" />
                <!-- 下一曲按钮 -->
                <image h="45" id="next" padding="10,10,10,10" scaleType="fitXY" src="#n:launcher/btn_next_n.png;#p:launcher/btn_next_p.png" w="45" x="191" y="345" />
            </musicModule>

            <group background="launcher/bt_card.png">
                <text y="316" color="#000000" layout_gravity="center_horizontal" size="28" text="@string:bt_phone" gravity="center_horizontal"/>
                <trigger>
                    <action name="cn.yunovo.nxos.activity.action.bt" type="activity" />
                </trigger>
            </group>

            <group background="launcher/radio_card.png">
                <text y="316" color="#000000" layout_gravity="center_horizontal" size="28" text="@string:radio" gravity="center_horizontal"/>
                <trigger>
                    <action name="cn.yunovo.nxos.activity.action.radio" type="activity" />
                </trigger>
            </group>


            <group background="launcher/settings_card.png">
                <text y="316" color="#000000" layout_gravity="center_horizontal" size="28" text="@string:settings" gravity="center_horizontal"/>
                <trigger>
                    <action name="cn.yunovo.car.settings/cn.yunovo.car.settings.SettingsListActivity" type="activity" />
                </trigger>
            </group>

            <group background="launcher/video_card.png">
                <text y="316" color="#000000" layout_gravity="center_horizontal" size="28" text="@string:video" gravity="center_horizontal"/>
                <trigger>
                    <action name="cn.yunovo.nxos.intent.action.MEDIA_BROWSER" type="activity" />
                </trigger>
            </group>
        </slide>
        <group w="-1" h="-2" x="106">
            <indicator active="launcher/pageindicator_n.png" h="-2" id="indicator" inactive="launcher/pageindicator_p.png" layout_gravity="center_horizontal" w="-2" y="560" />
        </group>


    </group>

    <applist background="#313840" h="600" id="applist" w="1024" x="0">
        <slide card_h="214" card_w="190" col="5" h="560" id="apps" indicator="page_indicator" padding="0,0,0,74" row="2" w="1020" x="2" y="80">
            <icon c_h="105" c_w="105" color="#f3f3f3" drawablePadding="5" gravity="center_horizontal" h="-2"
                icon_mask="launcher/applist/icons/applist_icon_mask.png"  icon_h="130"
                icon_w="130" id="app_icon" singleLine="true" size="25" w="-2" />
        </slide>
        <indicator h="-2" id="page_indicator" layout_gravity="center_horizontal" w="-2" y="545" active="launcher/pageindicator_n.png" inactive="launcher/pageindicator_p.png"/>
    </applist>
    <group background="#ffffff" h="240" id="uninstall_dialog" w="472">
        <text color="#9F9FA1" gravity="center_horizontal" h="60" id="title" size="24" text="卸载应用"
            w="-1" y="12" />
        <text color="#9F9FA1" gravity="center" h="47" id="content" layout_gravity="center_horizontal" size="24"
            text="卸载 %s?" w="392" y="92" />
        <text background="#C5C5C5" h="1" w="-1" x="0" y="169" />
        <text background="#ffffff" color="#9F9FA1" gravity="center" h="70" id="cancel" size="24" text="取消"
            w="235" x="0" y="170" />
        <text background="#ffffff" color="#9F9FA1" gravity="center" h="70" id="submit" size="24" text="确定"
            w="236" x="236" y="170" />
        <text background="#C5C5C5" h="70" w="1" x="235" y="170" />
    </group>
